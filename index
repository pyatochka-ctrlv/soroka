// STATE
let mode = new URLSearchParams(window.location.search).get('mode') || 'student';
let currentNews = null;
let clips = []; 
let historyList = [];
let historyIndex = -1;
let selectedClipId = null;
let activeTool = 'select';
let nextClipId = 1;
let isPlaying = false;
let playInterval = null;
let currentPlayWord = 0;
let WORDS_PER_SEC = 2.5;
let initialDurationStr = "";

// INIT
window.onload = () => {
  if (mode === 'teacher') {
    document.getElementById('teacher-view').classList.add('active');
    renderTeacherGrid();
  } else {
    document.getElementById('student-select').classList.add('active');
    renderStudentGrid();
  }
};

function renderTeacherGrid() {
  const grid = document.getElementById('teacher-grid');
  grid.innerHTML = '';
  NEWS.forEach(n => {
    const card = document.createElement('div');
    card.className = 'news-card';
    card.innerHTML = `<div class="num">${n.id}</div><div>${n.title}</div>`;
    card.onclick = () => card.classList.toggle('taken');
    grid.appendChild(card);
  });
}
function clearTeacherGrid() {
  if(confirm("Очистити всі позначки?")) {
    document.querySelectorAll('#teacher-grid .news-card').forEach(c => c.classList.remove('taken'));
  }
}

function renderStudentGrid() {
  const grid = document.getElementById('student-grid');
  grid.innerHTML = '';
  NEWS.forEach(n => {
    const card = document.createElement('div');
    card.className = 'news-card';
    card.innerHTML = `<div class="num">${n.id}</div><div>${n.title}</div>`;
    card.onclick = () => startEditor(n);
    grid.appendChild(card);
  });
}

// EDITOR CORE
function startEditor(newsItem) {
  document.getElementById('student-select').classList.remove('active');
  document.getElementById('editor-view').classList.add('active');
  currentNews = newsItem;
  document.getElementById('proj-title').innerText = currentNews.title;
  
  // Prepare library
  const trapSegment = currentNews.segments.find(s => s.type === 'trap');
  const libHtml = trapSegment.options.map((opt, idx) => 
    `<div class="library-item" onclick="replaceWithLibrary(${idx})">«${opt.text}»</div>`
  ).join('');
  document.getElementById('library-options').innerHTML = libHtml;
  
  // Prepare words
  let wordsArray = [];
  currentNews.segments.forEach(seg => {
    const wds = seg.text.split(' ').filter(w=>w.trim()!=='');
    wds.forEach(w => {
      wordsArray.push({ text: w, type: seg.type, replaceAs: seg.replaceAs });
    });
  });
  
  clips = [{
    id: nextClipId++,
    words: wordsArray,
    marker: null,
    isReplacement: false
  }];
  
  initialDurationStr = formatTimeCode(wordsArray.length / WORDS_PER_SEC);
  
  saveState();
  updateUI();
}

function formatTimeCode(seconds) {
  const secs = Math.ceil(seconds);
  const m = Math.floor(secs / 60);
  const s = secs % 60;
  return `${m}:${s.toString().padStart(2, '0')}`;
}

function updateUI() {
  renderTimeline();
  renderInspector();
  updateDuration();
  if(!isPlaying) updateMonitor();
}

function renderTimeline() {
  const trackV = document.getElementById('track-v');
  const trackM = document.getElementById('track-m');
  const trackA = document.getElementById('track-a');
  trackV.innerHTML = ''; trackM.innerHTML = ''; trackA.innerHTML = '';
  
  clips.forEach(clip => {
    const duration = clip.words.length / WORDS_PER_SEC;
    const widthPx = duration * 40; // 40px per second
    
    // Video Clip
    const div = document.createElement('div');
    div.className = `clip ${clip.id === selectedClipId ? 'selected' : ''}`;
    div.style.width = widthPx + 'px';
    if(clip.marker) div.setAttribute('data-marker', clip.marker);
    div.innerText = clip.words.slice(0, 3).map(w=>w.text).join(' ') + '...';
    div.onclick = () => selectClip(clip.id);
    trackV.appendChild(div);
    
    // Marker Track
    const mDiv = document.createElement('div');
    mDiv.style.width = widthPx + 'px';
    mDiv.style.position = 'relative';
    if(clip.marker) {
      let icon = clip.marker === 'thought' ? '💡' : clip.marker === 'reason' ? '🔑' : '📸';
      mDiv.innerHTML = `<span style="position:absolute; bottom:0; left:5px;">${icon}</span>`;
    }
    trackM.appendChild(mDiv);
    
    // Audio Track
    const aDiv = document.createElement('div');
    aDiv.style.width = widthPx + 'px';
    aDiv.style.padding = '0 2px';
    aDiv.innerHTML = `<div class="audio-wave"></div>`;
    trackA.appendChild(aDiv);
  });
}

function renderInspector() {
  const info = document.getElementById('inspector-info');
  const txt = document.getElementById('inspector-text');
  txt.innerHTML = '';
  
  const clip = clips.find(c => c.id === selectedClipId);
  if (!clip) {
    info.innerText = 'Виберіть кліп на таймлайні';
    document.getElementById('editor-view').classList.remove('blade-mode');
    return;
  }
  
  info.innerText = `Тривалість: ${formatTimeCode(clip.words.length / WORDS_PER_SEC)}`;
  if (activeTool === 'blade') {
    document.getElementById('editor-view').classList.add('blade-mode');
  } else {
    document.getElementById('editor-view').classList.remove('blade-mode');
  }
  
  clip.words.forEach((w, index) => {
    const span = document.createElement('span');
    span.className = 'inspector-word';
    span.innerText = w.text + ' ';
    if (activeTool === 'blade' && index < clip.words.length - 1) {
      span.onclick = () => cutClip(clip.id, index);
    }
    txt.appendChild(span);
  });
}

function updateDuration() {
  const totalWords = clips.reduce((acc, c) => acc + c.words.length, 0);
  const totalSecs = totalWords / WORDS_PER_SEC;
  const el = document.getElementById('duration-counter');
  el.innerText = `Тривалість: ${formatTimeCode(totalSecs)} / ціль 0:30`;
  if (totalSecs <= 30) el.classList.add('ok');
  else el.classList.remove('ok');
}

function updateMonitor() {
  const subs = document.getElementById('monitor-subs');
  subs.innerHTML = '';
  let wordIndex = 0;
  clips.forEach(clip => {
    clip.words.forEach(w => {
      const span = document.createElement('span');
      span.innerText = w.text + ' ';
      span.id = 'mon-word-' + wordIndex;
      subs.appendChild(span);
      wordIndex++;
    });
  });
}

// TOOLS
function setTool(tool) {
  activeTool = tool;
  document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
  if (tool === 'select') document.getElementById('tool-select').classList.add('active');
  if (tool === 'blade') document.getElementById('tool-blade').classList.add('active');
  updateUI();
}

function selectClip(id) {
  selectedClipId = id;
  if(activeTool === 'delete') {
    deleteSelected();
    setTool('select');
  } else {
    updateUI();
  }
}

function cutClip(id, wordIndex) {
  const clipIndex = clips.findIndex(c => c.id === id);
  if (clipIndex === -1) return;
  const clip = clips[clipIndex];
  
  const words1 = clip.words.slice(0, wordIndex + 1);
  const words2 = clip.words.slice(wordIndex + 1);
  
  const clip1 = { ...clip, words: words1 };
  const clip2 = { id: nextClipId++, words: words2, marker: clip.marker, isReplacement: clip.isReplacement };
  
  clips.splice(clipIndex, 1, clip1, clip2);
  selectedClipId = clip2.id;
  saveState();
  updateUI();
}

function deleteSelected() {
  if (!selectedClipId) return;
  clips = clips.filter(c => c.id !== selectedClipId);
  selectedClipId = null;
  saveState();
  updateUI();
}

function moveClip(dir) {
  if (!selectedClipId) return;
  const idx = clips.findIndex(c => c.id === selectedClipId);
  if (idx < 0) return;
  if (dir === -1 && idx > 0) {
    [clips[idx-1], clips[idx]] = [clips[idx], clips[idx-1]];
    saveState(); updateUI();
  } else if (dir === 1 && idx < clips.length - 1) {
    [clips[idx+1], clips[idx]] = [clips[idx], clips[idx+1]];
    saveState(); updateUI();
  }
}

function setMarker(type) {
  if (!selectedClipId) return;
  const clip = clips.find(c => c.id === selectedClipId);
  if (clip) {
    clip.marker = type;
    saveState();
    updateUI();
  }
}

function replaceWithLibrary(idx) {
  if (!selectedClipId) return alert("Спочатку виберіть кліп на таймлайні, який хочете замінити!");
  const trapSegment = currentNews.segments.find(s => s.type === 'trap');
  const opt = trapSegment.options[idx];
  applyReplacementText(opt.text, opt.correct ? trapSegment.replaceAs : 'water');
}

function applyCustomFrame() {
  if (!selectedClipId) return alert("Спочатку виберіть кліп на таймлайні, який хочете замінити!");
  const val = document.getElementById('custom-frame').value.trim();
  if(!val) return;
  const trapSegment = currentNews.segments.find(s => s.type === 'trap');
  applyReplacementText(val, trapSegment.replaceAs);
  document.getElementById('custom-frame').value = '';
}

function applyReplacementText(text, logicType) {
  const clipIndex = clips.findIndex(c => c.id === selectedClipId);
  const words = text.split(' ').filter(w=>w.trim()!=='').map(w => ({ text: w, type: logicType }));
  clips[clipIndex] = {
    id: nextClipId++,
    words: words,
    marker: null,
    isReplacement: true
  };
  selectedClipId = clips[clipIndex].id;
  saveState();
  updateUI();
}

// HISTORY
function saveState() {
  historyIndex++;
  historyList = historyList.slice(0, historyIndex);
  historyList.push(JSON.parse(JSON.stringify(clips)));
}
function undo() {
  if (historyIndex > 0) {
    historyIndex--;
    clips = JSON.parse(JSON.stringify(historyList[historyIndex]));
    selectedClipId = null;
    updateUI();
  }
}
function redo() {
  if (historyIndex < historyList.length - 1) {
    historyIndex++;
    clips = JSON.parse(JSON.stringify(historyList[historyIndex]));
    selectedClipId = null;
    updateUI();
  }
}

// PLAYBACK
function togglePlay() {
  if(isPlaying) {
    clearInterval(playInterval);
    isPlaying = false;
    document.querySelector('.play-btn').innerText = '▶';
    document.querySelectorAll('.monitor-subs span').forEach(s => s.classList.remove('active-word'));
  } else {
    isPlaying = true;
    document.querySelector('.play-btn').innerText = '⏸';
    currentPlayWord = 0;
    playInterval = setInterval(() => {
      document.querySelectorAll('.monitor-subs span').forEach(s => s.classList.remove('active-word'));
      const wSpan = document.getElementById('mon-word-' + currentPlayWord);
      if(wSpan) {
        wSpan.classList.add('active-word');
        document.getElementById('monitor-tc').innerText = formatTimeCode(currentPlayWord / WORDS_PER_SEC);
        currentPlayWord++;
      } else {
        togglePlay(); // auto stop
      }
    }, 1000 / WORDS_PER_SEC);
  }
}

// VALIDATION
function exportVideo() {
  if(isPlaying) togglePlay();
  
  let totalWords = 0;
  let hasWater = false;
  let hasTrap = false;
  
  let foundThought = false;
  let foundReason = false;
  let foundExample = false;
  
  clips.forEach(clip => {
    totalWords += clip.words.length;
    clip.words.forEach(w => {
      if (w.type === 'water') hasWater = true;
      if (w.type === 'trap') hasTrap = true;
      if (w.type === 'thought' || w.replaceAs === 'thought') foundThought = true;
      if (w.type === 'reason' || w.replaceAs === 'reason') foundReason = true;
      if (w.type === 'example' || w.replaceAs === 'example') foundExample = true;
    });
  });

  const durationSec = totalWords / WORDS_PER_SEC;

  // Hints priority: missing core -> water -> trap -> order -> markers -> duration
  if (!foundThought || !foundReason || !foundExample) {
    return showHint("Здається, ви випадково вирізали щось важливе: саму думку, її причину або приклад. Спробуйте повернути скасуванням (↶) і вирізати обережніше.");
  }
  if (hasWater) {
    return showHint("У кадрі ще залишилась «вода» — речення, які не стосуються суті новини. Знайдіть їх і відріжте лезом!");
  }
  if (hasTrap) {
    return showHint("Обережно, у тексті сховалася «пастка»! Це речення ніби про те саме, але не підтримує нашу думку. Її треба замінити кадром з бібліотеки.");
  }
  
  // Order & markers check (must have exactly 3 marked clips in order: thought, reason, example)
  const markedClips = clips.filter(c => c.marker !== null);
  if (markedClips.length !== 3) {
    return showHint("Перевірте маркери! У вас має бути рівно три частини: Думка (💡), Причина (🔑) і Приклад (📸).");
  }
  if (markedClips[0].marker !== 'thought' || markedClips[1].marker !== 'reason' || markedClips[2].marker !== 'example') {
    return showHint("Неправильний порядок або переплутані маркери. Має бути так: спочатку Думка (💡), потім Бо (🔑), потім Наприклад (📸). Перетягніть кліпи, щоб змінити порядок.");
  }
  
  // Check if content matches marker
  const validM1 = markedClips[0].words.some(w => w.type === 'thought' || w.replaceAs === 'thought');
  const validM2 = markedClips[1].words.some(w => w.type === 'reason' || w.replaceAs === 'reason');
  const validM3 = markedClips[2].words.some(w => w.type === 'example' || w.replaceAs === 'example');
  
  if (!validM1 || !validM2 || !validM3) {
    return showHint("Здається, маркери стоять не на тих кліпах. Перечитайте текст в інспекторі та перевірте, де насправді думка, де причина, а де приклад.");
  }

  if (durationSec > 30) {
    return showHint("Ви майже впоралися, але тривалість більше 30 секунд. Пошукайте, чи не залишилося ще якихось зайвих слів для видалення.");
  }

  // SUCCESS!
  document.getElementById('editor-view').classList.remove('active');
  document.getElementById('success-view').classList.add('active');
  
  document.getElementById('success-compare').innerText = `Було ${initialDurationStr} → стало ${formatTimeCode(durationSec)}`;
  
  let finalHtml = "";
  clips.forEach(c => {
    let icon = c.marker === 'thought' ? '💡' : c.marker === 'reason' ? '🔑' : '📸';
    let text = c.words.map(w=>w.text).join(' ');
    finalHtml += `<div style="margin-bottom:15px"><strong>${icon}</strong> ${text}</div>`;
  });
  document.getElementById('success-text').innerHTML = finalHtml;
}

// HINTS
function showHint(customText = null) {
  let text = customText || "Перечитай текст у моніторі або в інспекторі. Чи всі частини на місці? Чи немає зайвих речень? Звертай увагу на тривалість.";
  document.getElementById('hint-text').innerText = text;
  document.getElementById('hint-modal').style.display = 'flex';
}
function closeHint() {
  document.getElementById('hint-modal').style.display = 'none';
}

